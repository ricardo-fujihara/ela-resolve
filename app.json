{
  "expo": {
    "name": "Ela Resolve",
    "slug": "ela-resolve",
    "version": "3.0.0",
    "orientation": "portrait",
    "scheme": "elaresolve",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
